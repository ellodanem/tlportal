// TL Portal — Track Lucia admin
// https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum DeviceStatus {
  in_stock
  assigned
  suspended
  returned
  decommissioned
  lost
}

enum DeviceCondition {
  new
  refurbished
  faulty
}

enum ServiceAssignmentStatus {
  active
  due_soon
  overdue
  suspended
  cancelled
}

/// Why a service assignment was paused (hardware offline, no vehicle, etc.).
enum ServiceAssignmentPauseReason {
  accident
  no_vehicle
  seasonal
  delinquent
  other
}

enum RegistrationRequestStatus {
  pending
  approved
  rejected
}

/// Public feedback inbox (UI label for `inbox` is "New").
enum FeedbackStatus {
  inbox
  reviewed
  featured
  archived
}

/// Commercial / lifecycle classification (default: customer-facing production units).
enum DeviceUsagePurpose {
  customer
  internal_demo
  field_test
  personal
}

/// What the tracker is installed on (fleet / ops labeling).
enum DeviceObjectType {
  car
  pickup
  suv
  truck
  bike
  ambulance
  fire_truck
  atv
  boat
  container
  bus
  garbage_truck
  jet_ski
  speed_boat
}

enum ProposalStatus {
  draft
  sent
}

enum ProposalLineCategory {
  hardware
  subscription
  installation
  service
  other
}

enum ProposalVisualKind {
  media
  timeline
}

enum ProposalVisualLayout {
  full_width
  half_width
}

/// Sidebar logo height preset (admin branding).
enum BrandingLogoSize {
  s
  m
  l
  xl
}

/// How the customer is billed (TL ops view; provider details on BillingAccount).
enum CustomerBillingMode {
  manual_legacy
  stripe_subscription
}

/// Whether the customer receives scheduled payment due/overdue reminders (all channels).
/// `auto`: manual payers on, Stripe off (decline follow-up covers card failures).
enum PaymentRemindersPreference {
  auto
  on
  off
}

/// Customer-facing billing notification transport. Customer SMS is intentionally excluded.
enum BillingNotificationChannel {
  email
  whatsapp
}

enum BillingNotificationStatus {
  pending
  sending
  sent
  failed
  suppressed
}

enum BillingProvider {
  invoiless
  stripe
}

enum BillingInvoiceKind {
  subscription
  one_time
}

enum BillingOperationType {
  stripe_checkout_activation
  canonical_stripe_activation
  canonical_stripe_synchronization
}

enum BillingOperationStatus {
  pending
  in_progress
  completed
  failed
  retry_required
}

// --- Native billing (Phase 0): TL-owned quotes / invoices / payments ---

/// Lifecycle of a native TL quote (estimate). `converted` once an Invoice is generated from it.
enum QuoteStatus {
  draft
  sent
  accepted
  declined
  expired
  converted
}

/// Lifecycle of a native TL invoice (the AR record). Distinct from the Stripe `BillingInvoice` mirror.
enum InvoiceStatus {
  draft
  open
  partially_paid
  paid
  overdue
  void
  written_off
}

/// Origin of a native invoice. `subscription_mirror` reserved for unifying Stripe invoices (Phase 4).
enum InvoiceKind {
  one_off
  recurring
  annual_adjustment
  subscription_mirror
  /// Historical row imported from Invoiless at cutover (Phase 7).
  invoiless_import
}

/// Owner classification for a standalone native invoice during canonical migration.
/// `unreviewed` invoices are preserved as financial history but never become a
/// subscription migration source without a deliberate owner decision.
enum InvoiceMigrationClassification {
  unreviewed
  non_subscription
  recurring_evidence
}

/// How a recorded payment was received against a native invoice.
enum PaymentMethod {
  stripe
  cash
  bank_transfer
  cheque
  card_manual
  other
}

/// Lifecycle of a native recurring invoice schedule (cash/cheque/bank payers).
enum RecurringScheduleStatus {
  active
  paused
  ended
}

/// Delivery lifecycle for an automatically emailed recurring native invoice.
enum RecurringInvoiceDeliveryStatus {
  sending
  sent
  failed
  not_requested
}

enum ScheduledInvoiceEmailStatus {
  pending
  sent
  failed
  cancelled
}

/// How an expense was paid (Phase 5 — simple expense register).
enum ExpensePaymentMethod {
  cash
  bank_transfer
  card
  cheque
  other
}

enum VendorBillStatus {
  draft
  open
  partially_paid
  paid
  overdue
  void
}

/// TL-owned subscription lifecycle (Stripe mirrors payment; this is ops source of truth).
enum CustomerSubscriptionStatus {
  pending_payment
  active
  past_due
  unpaid
  canceled
  trialing
  paused
}

/// How a canonical commercial subscription is collected.
enum SubscriptionCollectionMethod {
  manual_invoice
  stripe_autocharge
}

/// Commercial agreement lifecycle, separate from provider/payment state.
enum SubscriptionLifecycleStatus {
  draft
  pending_activation
  active
  paused
  canceled
  ended
}

/// Derived projection from invoices/payments; not an independently editable staff status.
enum SubscriptionCollectionHealth {
  not_started
  current
  past_due
  unpaid
  action_required
}

/// Controls whether legacy engines, shadow comparison, or canonical billing owns execution.
enum SubscriptionControlMode {
  legacy
  shadow
  canonical
}

/// Staff's explicit decision for the first commercial service period.
/// Deferred means the first invoice is intentionally left to the configured
/// renewal schedule; it never means the customer has paid.
enum CanonicalInitialBillingMode {
  advance_invoice
  deferred
}

/// Commercial state of one billable service within a canonical subscription.
enum SubscriptionItemStatus {
  draft
  pending_activation
  active
  paused
  ended
  canceled
}

/// Whether an effective-dated item price is catalog-standard or negotiated.
enum SubscriptionRateClassification {
  standard
  negotiated
}

/// Lifecycle of one explicitly approved legacy-to-canonical shadow migration.
enum CanonicalMigrationStatus {
  approved
  in_progress
  completed
  failed_rolled_back
  needs_review
  reversed
}

/// Durable owner-approved migration campaign. A campaign coordinates review and
/// progress only; each entry executes in its own transaction.
enum CanonicalMigrationCampaignStatus {
  approved
  executing
  completed
  completed_with_exceptions
  needs_review
}

/// State of one independently executable migration arrangement in a campaign.
enum CanonicalMigrationCampaignEntryStatus {
  approved
  executing
  migrated
  blocked
  failed
  skipped
}

/// Durable state for one owner-approved manual-billing pilot cutover.
enum CanonicalManualPilotStatus {
  approved
  in_progress
  active
  failed_rolled_back
  reversed
  needs_review
}

/// Broadcast message templates (email now; WhatsApp body reserved for phase 2).
enum BroadcastTemplateCategory {
  outage
  maintenance
  general
  billing
}

enum BroadcastCampaignStatus {
  queued
  sending
  completed
  completed_with_errors
  failed
  cancelled
}

enum BroadcastDeliveryStatus {
  pending
  sent
  failed
  skipped
}

/// GPS / telematics platform linked to a device.
enum GpsProvider {
  traqcare
}

enum DeviceLinkRole {
  primary
  secondary
  migrating
}

/// Atomic counter for customer-facing `TL-INV-{n}` numbers (singleton id = "default").
/// Shared by the Stripe `BillingInvoice` mirror AND native `Invoice` so numbers never collide.
model InvoiceSequence {
  id        String   @id
  nextValue Int
  updatedAt DateTime @updatedAt
}

/// Atomic counter for customer-facing `TL-Q-{n}` quote numbers (singleton id = "default").
model QuoteSequence {
  id        String   @id
  nextValue Int
  updatedAt DateTime @updatedAt
}

// --- App config (singleton row id = "default") ---

model AppSettings {
  id                          String           @id
  logoUrl                     String?
  logoSize                    BrandingLogoSize @default(m)
  /// Outgoing mail (SMTP). When `smtpHost` is null, other SMTP fields are ignored.
  smtpHost                    String?
  smtpPort                    Int              @default(587)
  /// When true, Nodemailer uses implicit TLS (typical for port 465).
  smtpSecure                  Boolean          @default(false)
  smtpUser                    String?
  smtpPassword                String?
  smtpFromEmail               String?
  smtpFromName                String?
  /// Comma- or newline-separated E.164-ish phones for billing ops SMS (missing pay link, etc.).
  billingAlertPhones          String?          @db.Text
  /// When true, email TL paid receipt PDFs on Stripe `invoice.paid` (requires SMTP).
  autoEmailPaidStripeReceipts Boolean          @default(true)
  /// IANA timezone for portal calendar dates (billing reminders, due dates). Default St. Lucia.
  businessTimezone            String           @default("America/St_Lucia")
  /// Human-readable business location label (e.g. St. Lucia).
  businessLocation            String           @default("St. Lucia")
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
}

// --- Auth (admin) ---

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviewedRegistrationRequests RegistrationRequest[] @relation("RegistrationReviewedBy")
  reviewedFeedbackSubmissions  FeedbackSubmission[]  @relation("FeedbackReviewedBy")
  proposalsCreated             Proposal[]

  // Native billing (Phase 0) — staff authorship / payment recording.
  quotesCreated                             Quote[]
  invoicesCreated                           Invoice[]
  scheduledInvoiceEmailsCreated             ScheduledInvoiceEmail[]
  paymentsRecorded                          Payment[]
  recurringSchedulesCreated                 RecurringInvoiceSchedule[]
  billingNotificationRetries                BillingNotificationDelivery[]                @relation("BillingNotificationRetriedBy")
  vendorBillsCreated                        VendorBill[]
  vendorBillPaymentsRecorded                VendorBillPayment[]
  subscriptionItemRatesCreated              SubscriptionItemRate[]
  canonicalSubscriptionActivationsApproved  CanonicalSubscriptionOperationalActivation[] @relation("CanonicalActivationApprovedBy")
  canonicalSubscriptionActivationsPerformed CanonicalSubscriptionOperationalActivation[] @relation("CanonicalActivationPerformedBy")
  canonicalMigrationCampaignsCreated        CanonicalMigrationCampaign[]                 @relation("CanonicalMigrationCampaignCreatedBy")
  canonicalMigrationCampaignsApproved       CanonicalMigrationCampaign[]                 @relation("CanonicalMigrationCampaignApprovedBy")
  invoiceMigrationClassifications           InvoiceMigrationClassificationAudit[]
}

// --- Core domain ---

model Customer {
  id                   String                     @id @default(uuid())
  firstName            String?
  lastName             String?
  company              String?
  email                String?
  phone                String?
  /// Street / multi-line address (Invoiless “Address”); city/state/postal/country are composed into billTo.address on sync.
  address              String?
  city                 String?
  state                String?
  postalCode           String?
  country              String?
  /// Maps to Invoiless billTo.legal (e.g. company / tax registration).
  legalInfo            String?
  /// Comma-separated Cc emails for invoice sends (Invoiless max 3).
  invoiceCc            String?
  /// Comma-separated Bcc emails (Invoiless max 3).
  invoiceBcc           String?
  /// Preferred billing path for new workflows (legacy rows default manual_legacy).
  billingMode          CustomerBillingMode        @default(manual_legacy)
  /// Scheduled payment reminders (WhatsApp ladder today; all channels later). Default auto.
  paymentReminders     PaymentRemindersPreference @default(auto)
  /// Custom Stripe subscription monthly rate (XCD). Null = default catalog / env Price ids.
  stripeMonthlyRateXcd Decimal?                   @db.Decimal(10, 2)
  /// When true (default), new Checkout links gross up so the customer pays Stripe processing. When false, Track Lucia absorbs the fee and the customer pays the listed rate.
  stripeFeePassthrough Boolean                    @default(true)
  /// @deprecated Prefer BillingAccount — kept for backward compatibility during Phase 1.
  invoilessCustomerId  String?                    @unique
  /// @deprecated Prefer CustomerPortalUser — kept for migration backfill / read fallback.
  traqcareUsername     String?
  /// @deprecated Prefer CustomerPortalUser — stored as plain text; restrict DB access.
  traqcarePassword     String?
  /// Traqcare / white-label portal base URL if not the default (e.g. https://…).
  traqcarePortalUrl    String?
  /// Traqcare live API `clientid` — one fleet id per customer (copy from Traqcare platform).
  traqcareClientId     String?
  notes                String?
  tags                 String[]                   @default([])
  /// Set when staff archives a churned / inactive account — hidden from active lists and billing reminders.
  archivedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  serviceAssignments            ServiceAssignment[]
  billingAccounts               BillingAccount[]
  billingInvoices               BillingInvoice[]
  billingWhatsAppReminders      BillingWhatsAppReminder[]
  billingNotificationDeliveries BillingNotificationDelivery[]
  billingPayLinkAdminAlerts     BillingPayLinkAdminAlert[]
  customerWhatsAppDeliveries    CustomerWhatsAppDelivery[]
  whatsappConversations         WhatsAppConversation[]
  customerSubscriptions         CustomerSubscription[]
  billingOperations             BillingOperation[]
  operationalEvents             OperationalEvent[]
  broadcastDeliveries           BroadcastDelivery[]
  portalUsers                   CustomerPortalUser[]
  contacts                      CustomerContact[]

  registrationEmailMatches RegistrationRequest[] @relation("RegistrationEmailMatchCustomer")
  createdFromRegistration  RegistrationRequest?  @relation("RegistrationCreatedCustomer")
  feedbackEmailMatches     FeedbackSubmission[]  @relation("FeedbackEmailMatchCustomer")
  proposals                Proposal[]

  // Native billing (Phase 0) — TL-owned quotes, invoices, payments.
  quotes                            Quote[]
  invoices                          Invoice[]
  payments                          Payment[]
  recurringInvoiceSchedules         RecurringInvoiceSchedule[]
  vendorBills                       VendorBill[]
  canonicalMigrationLedgers         CanonicalMigrationLedger[]
  canonicalMigrationCampaignEntries CanonicalMigrationCampaignEntry[]
  canonicalManualPilotActivations   CanonicalManualPilotActivation[]
  canonicalOperationalActivations   CanonicalSubscriptionOperationalActivation[]

  @@index([archivedAt])
}

/// Traqcare / GPS portal login for a customer (multiple people per fleet).
model CustomerPortalUser {
  id               String   @id @default(uuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Display name of the person who uses this login.
  name             String?
  email            String?
  phone            String?
  traqcareUsername String?
  /// Stored in DB as plain text — restrict DB access; prefer env/secret store for production.
  traqcarePassword String?
  /// e.g. owner, dispatcher, driver — free text for now.
  role             String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([customerId])
}

/// Business contact associated with a customer account. Separate from Traqcare portal credentials.
model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name  String?
  email String?
  phone String?
  role  String?
  notes String? @db.Text

  isBillingContact    Boolean @default(false)
  isOperationsContact Boolean @default(false)
  isMessageContact    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, name])
  @@index([customerId, isBillingContact])
}

/// Public registration form — four fixed terms (1 / 3 / 6 / 12 month); staff edit price only.
model SubscriptionOption {
  id             String   @id @default(uuid())
  /// Billing term length in months; exactly one row per value in { 1, 3, 6, 12 }.
  durationMonths Int      @unique
  priceXcd       Decimal  @db.Decimal(10, 2)
  /// Stripe Price id (`price_…`) for Checkout; overrides env `STRIPE_PRICE_ID_*` when set.
  stripePriceId  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registrationRequests RegistrationRequest[]
}

/// Stripe catalog: per-vehicle Price id for monthly rate tier × billing term (Checkout quantity = vehicles).
model SubscriptionCatalogPrice {
  id             String   @id @default(uuid())
  /// Per-vehicle monthly rate tier (e.g. 30, 25, 20 XCD).
  monthlyRateXcd Decimal  @db.Decimal(10, 2)
  durationMonths Int
  /// Stripe Price (`price_…`) per vehicle for this billing interval.
  stripePriceId  String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([monthlyRateXcd, durationMonths])
  @@index([durationMonths])
}

/// Client-submitted registration; staff approves → Customer created (Invoiless separate).
model RegistrationRequest {
  id     String                    @id @default(uuid())
  status RegistrationRequestStatus @default(pending)

  firstName String
  lastName  String
  /// WhatsApp / primary phone from the registration form.
  phone     String
  email     String

  vehicleDetails       String              @db.Text
  /// Optional extra portal users from the registration form (free text, one per line).
  additionalUsers      String?             @db.Text
  subscriptionOptionId String?
  subscriptionOption   SubscriptionOption? @relation(fields: [subscriptionOptionId], references: [id], onDelete: SetNull)

  termInstallAfterPayment Boolean
  termHardwarePerVehicle  Boolean
  termTravelFee           Boolean

  /// Existing customer with the same email (reviewer duplicate flag).
  matchesCustomerId     String?
  matchesCustomer       Customer? @relation("RegistrationEmailMatchCustomer", fields: [matchesCustomerId], references: [id], onDelete: SetNull)
  /// Count of other pending rows with the same email when this row was submitted.
  otherPendingSameEmail Int       @default(0)

  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("RegistrationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?   @db.Text

  createdCustomerId String?   @unique
  createdCustomer   Customer? @relation("RegistrationCreatedCustomer", fields: [createdCustomerId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([submittedAt])
}

/// Public /feedback submissions; staff review and optionally copy for social.
model FeedbackSubmission {
  id     String         @id @default(uuid())
  status FeedbackStatus @default(inbox)

  body            String  @db.Text
  rating          Int?
  displayName     String?
  email           String?
  phone           String?
  sharePermission Boolean @default(false)

  matchesCustomerId String?
  matchesCustomer   Customer? @relation("FeedbackEmailMatchCustomer", fields: [matchesCustomerId], references: [id], onDelete: SetNull)

  /// Staff-only; never copied into social captions.
  adminNote String? @db.Text

  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("FeedbackReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([submittedAt])
  @@index([sharePermission])
  @@index([email])
}

model DeviceModel {
  id                 String   @id @default(uuid())
  name               String
  manufacturer       String?
  category           String?
  description        String?
  retailPrice        Decimal  @db.Decimal(12, 2)
  costPrice          Decimal? @db.Decimal(12, 2)
  invoilessProductId String?  @unique
  isActive           Boolean  @default(true)
  imageUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  devices       Device[]
  setupCommands DeviceModelSetupCommand[]
}

/// Copy-paste setup commands for a device model. Shown on Manage device.
model DeviceModelSetupCommand {
  id        String   @id @default(uuid())
  sortOrder Int
  name      String
  body      String   @db.Text
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)

  @@index([deviceModelId, sortOrder])
}

model Device {
  id                String             @id @default(uuid())
  imei              String             @unique
  serialNumber      String?
  label             String?
  status            DeviceStatus       @default(in_stock)
  condition         DeviceCondition    @default(new)
  purchasedAt       DateTime?
  warrantyExpiresAt DateTime?
  firmwareVersion   String?
  notes             String?
  /// Billable / customer-facing vs internal, demo, or personal test units.
  usagePurpose      DeviceUsagePurpose @default(customer)
  /// Vehicle / asset class for UI and reporting (optional).
  objectType        DeviceObjectType?
  /// Free-form labels (e.g. demo-booth, test-vehicle-a); use for search and reporting.
  tags              String[]           @default([])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Restrict)

  simCardId String?  @unique
  simCard   SimCard? @relation(fields: [simCardId], references: [id], onDelete: SetNull)

  serviceAssignments  ServiceAssignment[]
  providerDeviceLinks ProviderDeviceLink[]
  operationalEvents   OperationalEvent[]
  vendorBills         VendorBill[]

  @@index([deviceModelId])
  @@index([status])
  @@index([usagePurpose])
  @@index([objectType])
}

model SimCard {
  id             String    @id @default(uuid())
  iccid          String    @unique
  msisdn         String?
  imsi           String?
  label          String?
  /// Carrier or operator supplied by the import source or entered by an operator.
  providerName   String?
  /// `1nce` records may use the provider API; `manual` records are operator-maintained.
  source         String    @default("1nce")
  notes          String?   @db.Text
  status         String    @default("Active")
  totalDataMB    Float?
  usedDataMB     Float?
  dataExpiryDate DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  device Device?

  serviceAssignments ServiceAssignment[]

  @@index([iccid])
  @@index([status])
  @@index([usedDataMB])
}

model ServiceAssignment {
  id                   String                        @id @default(uuid())
  startDate            DateTime?
  endDate              DateTime?
  status               ServiceAssignmentStatus       @default(active)
  invoilessRecurringId String?
  intervalMonths       Int?
  lastInvoiceId        String?
  lastPaymentStatus    String?
  nextDueDate          DateTime?
  notes                String?
  pausedAt             DateTime?
  pauseReason          ServiceAssignmentPauseReason?
  pauseNote            String?                       @db.Text
  /// Snapshot of next due at pause (time-freeze on resume for manual billing).
  frozenNextDueDate    DateTime?
  resumedAt            DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  simCardId String?
  simCard   SimCard? @relation(fields: [simCardId], references: [id], onDelete: SetNull)

  /// Canonical commercial service represented by this historical hardware assignment.
  subscriptionItemId String?
  subscriptionItem   SubscriptionItem? @relation(fields: [subscriptionItemId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([deviceId])
  @@index([status])
  @@index([nextDueDate])
  @@index([subscriptionItemId])
}

/// Sales proposal (PDF to client). Estimate/invoice flow is separate (e.g. Invoiless).
model Proposal {
  id     String         @id @default(uuid())
  status ProposalStatus @default(draft)

  title String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Primary display name on cover (company or contact).
  clientLabel       String?
  clientCompany     String?
  clientContactName String?
  clientEmail       String?
  clientPhone       String?
  clientAddress     String? @db.Text

  executiveSummary String? @db.Text
  /// Plain text: one bullet per line for the “included capabilities” section.
  includedFeatures String? @db.Text
  assumptionsText  String? @db.Text
  nextStepsText    String? @db.Text
  termsText        String? @db.Text
  pricingFootnote  String? @db.Text

  currencyCode String @default("XCD")
  validityDays Int    @default(14)

  salesContactName  String?
  salesContactTitle String?
  salesContactEmail String?
  salesContactPhone String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lineItems ProposalLineItem[]
  visuals   ProposalVisualBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([updatedAt])
}

model ProposalLineItem {
  id String @id @default(uuid())

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  sortOrder Int                  @default(0)
  category  ProposalLineCategory @default(other)

  description String
  quantity    Decimal @default(1) @db.Decimal(12, 4)
  unitLabel   String?
  unitPrice   Decimal @db.Decimal(12, 2)

  @@index([proposalId])
}

model ProposalVisualBlock {
  id String @id @default(uuid())

  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  sortOrder       Int                  @default(0)
  title           String
  caption         String?              @db.Text
  imageUrl        String?
  placeholderHint String?
  /// Accessibility / PDF note when an image is present.
  imageAlt        String?
  kind            ProposalVisualKind   @default(media)
  layout          ProposalVisualLayout @default(full_width)
  /// When `kind` is `timeline`, JSON array of { "title": string, "detail"?: string }.
  timelineSteps   Json?

  @@index([proposalId])
}

// --- Vendor abstraction (Phase 1) ---

/// External billing identity per customer (Invoiless, Stripe, …).
model BillingAccount {
  id                 String              @id @default(uuid())
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider           BillingProvider
  externalCustomerId String
  mode               CustomerBillingMode @default(manual_legacy)
  /// Provider-specific status mirror (e.g. Stripe subscription status).
  status             String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([customerId, provider])
  @@unique([provider, externalCustomerId])
  @@index([customerId])
}

/// Mirrored invoice from a billing provider (Stripe subscription/one-time, future Invoiless).
model BillingInvoice {
  id                         String                    @id @default(uuid())
  customerId                 String
  customer                   Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Optional canonical attribution; null remains valid for legacy provider invoices.
  customerSubscriptionId     String?
  customerSubscription       CustomerSubscription?     @relation(fields: [customerSubscriptionId], references: [id], onDelete: SetNull)
  subscriptionProviderLinkId String?
  subscriptionProviderLink   SubscriptionProviderLink? @relation(fields: [subscriptionProviderLinkId], references: [id], onDelete: SetNull)
  provider                   BillingProvider
  externalInvoiceId          String
  kind                       BillingInvoiceKind        @default(subscription)
  status                     String
  amountXcd                  Decimal                   @db.Decimal(12, 2)
  currency                   String                    @default("xcd")
  /// Customer-facing number on PDF and Billing UI (e.g. TL-INV-100837).
  displayNumber              String?                   @unique
  /// Provider invoice number (Stripe `invoice.number`).
  providerInvoiceNumber      String?
  periodStart                DateTime?
  periodEnd                  DateTime?
  hostedInvoiceUrl           String?
  invoicePdfUrl              String?
  stripeSubscriptionId       String?
  paidAt                     DateTime?
  /// Stripe event creation time used to reject stale, out-of-order canonical updates.
  providerEventCreatedAt     DateTime?
  /// Invoiless invoice id created when mirroring Stripe `invoice.paid` (accounting copy).
  invoilessMirrorInvoiceId   String?
  /// Vercel Blob path prefix `private:` + url, or public blob url for TL paid PDF.
  pdfStoragePath             String?
  pdfGeneratedAt             DateTime?
  /// When the TL paid receipt PDF was emailed to the customer (auto or manual).
  receiptEmailedAt           DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  /// Unified AR row in native `Invoice` (Phase 4).
  nativeMirror Invoice?

  @@unique([provider, externalInvoiceId])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([customerSubscriptionId])
  @@index([subscriptionProviderLinkId])
  @@index([status])
  @@index([providerEventCreatedAt])
}

/// Sent billing WhatsApp reminders (Twilio Content); one row per customer × kind × due date.
model BillingWhatsAppReminder {
  id               String   @id @default(uuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// due_5d | due_3d | due_0d | overdue_3d | overdue_5d
  reminderKind     String
  nextDueDate      DateTime @db.Date
  twilioMessageSid String?
  payLinkSource    String?
  sentAt           DateTime @default(now())

  @@unique([customerId, reminderKind, nextDueDate])
  @@index([customerId, sentAt(sort: Desc)])
}

/// Durable per-channel ledger for automatic and staff-retried billing notices.
model BillingNotificationDelivery {
  id                String                     @id @default(uuid())
  idempotencyKey    String                     @unique
  customerId        String
  customer          Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId         String?
  invoice           Invoice?                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  eventKind         String
  channel           BillingNotificationChannel
  status            BillingNotificationStatus  @default(pending)
  destination       String?
  providerMessageId String?
  attempts          Int                        @default(0)
  lastError         String?                    @db.Text
  claimedAt         DateTime?
  sentAt            DateTime?
  suppressedAt      DateTime?
  retriedById       String?
  retriedBy         User?                      @relation("BillingNotificationRetriedBy", fields: [retriedById], references: [id], onDelete: SetNull)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([customerId, status, createdAt(sort: Desc)])
  @@index([invoiceId, eventKind])
}

/// One-off customer WhatsApp (Stripe checkout link, new Invoiless invoice).
model CustomerWhatsAppDelivery {
  id               String   @id @default(uuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind             String
  externalRef      String
  twilioMessageSid String?
  sentAt           DateTime @default(now())

  @@unique([kind, externalRef])
  @@index([customerId, sentAt(sort: Desc)])
}

/// WhatsApp thread keyed by customer phone (E.164). Unmatched inbound keeps customerId null.
model WhatsAppConversation {
  id            String            @id @default(uuid())
  /// Digits with leading +, no whatsapp: prefix.
  phoneE164     String            @unique
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime          @default(now())
  lastInboundAt DateTime?
  unreadCount   Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  messages      WhatsAppMessage[]

  @@index([customerId, lastMessageAt(sort: Desc)])
  @@index([lastMessageAt(sort: Desc)])
}

model WhatsAppMessage {
  id               String               @id @default(uuid())
  conversationId   String
  conversation     WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// inbound | outbound
  direction        String
  body             String?              @db.Text
  twilioMessageSid String?              @unique
  status           String?
  /// Staff user id for outbound replies.
  actorUserId      String?
  /// template | freeform | inbound
  kind             String               @default("inbound")
  occurredAt       DateTime             @default(now())
  rawPayload       Json?

  @@index([conversationId, occurredAt])
}

/// Staff SMS sent when a customer reminder was skipped (no pay link).
model BillingPayLinkAdminAlert {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reminderKind String
  nextDueDate  DateTime @db.Date
  notifiedAt   DateTime @default(now())

  @@unique([customerId, reminderKind, nextDueDate])
  @@index([notifiedAt(sort: Desc)])
}

/// Idempotency for Stripe webhooks (`evt_…` primary key).
model StripeWebhookEvent {
  id             String                 @id
  type           String
  status         BillingOperationStatus @default(completed)
  attemptCount   Int                    @default(0)
  lastAttemptAt  DateTime?
  processedAt    DateTime?
  failureMessage String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([processedAt])
  @@index([status, lastAttemptAt])
}

/// Durable state for provider mutations that must be safe to retry.
model BillingOperation {
  id                            String                 @id @default(uuid())
  type                          BillingOperationType
  status                        BillingOperationStatus @default(pending)
  customerId                    String
  customer                      Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerSubscriptionId        String?
  customerSubscription          CustomerSubscription?  @relation(fields: [customerSubscriptionId], references: [id], onDelete: SetNull)
  /// Stable logical identifier used to derive provider idempotency keys.
  operationKey                  String                 @unique
  /// One unresolved Checkout activation per customer. Cleared when completed/superseded.
  activeKey                     String?                @unique
  requestFingerprint            String
  providerReference             String?
  providerSubscriptionReference String?
  attemptCount                  Int                    @default(0)
  lastAttemptAt                 DateTime?
  nextRetryAt                   DateTime?
  completedAt                   DateTime?
  failureCode                   String?
  failureMessage                String?                @db.Text
  metadata                      Json?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  @@index([customerId, type, createdAt(sort: Desc)])
  @@index([status, nextRetryAt])
  @@index([providerReference])
}

/// Customer-level subscription (TL source of truth; Stripe id when linked).
model CustomerSubscription {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Canonical commercial agreement foundation. Nullable fields intentionally leave legacy rows unclassified.
  name                  String?
  reference             String?
  collectionMethod      SubscriptionCollectionMethod?
  lifecycleStatus       SubscriptionLifecycleStatus?
  /// Derived/cache projection only; future billing services must calculate this from financial records.
  collectionHealth      SubscriptionCollectionHealth?
  /// Commercial billing cadence. Database constraint permits only 1, 3, 4, 6, or 12 when set.
  billingIntervalMonths Int?
  currency              String?                       @db.VarChar(3)
  agreedAmountPerCycle  Decimal?                      @db.Decimal(12, 2)
  commercialStartDate   DateTime?                     @db.Date
  billingAnchorDate     DateTime?                     @db.Date
  nextBillingDate       DateTime?                     @db.Date
  gracePeriodDays       Int                           @default(7)
  controlMode           SubscriptionControlMode       @default(legacy)

  // Legacy/provider fields remain authoritative until an explicit later-phase cutover.
  status                         CustomerSubscriptionStatus                  @default(pending_payment)
  /// Billing term length in months (1, 3, 6, 12).
  planTermMonths                 Int
  /// Monthly rate in XCD used for this subscription (null = catalog default at checkout).
  monthlyRateXcd                 Decimal?                                    @db.Decimal(10, 2)
  /// Billed vehicle/device quantity when set; otherwise derived from active assignments in UI.
  vehicleCount                   Int?
  stripeSubscriptionId           String?                                     @unique
  stripeCustomerId               String?
  currentPeriodStart             DateTime?
  currentPeriodEnd               DateTime?
  cancelAt                       DateTime?
  createdAt                      DateTime                                    @default(now())
  updatedAt                      DateTime                                    @updatedAt
  billingOperations              BillingOperation[]
  invoices                       Invoice[]
  recurringSchedules             RecurringInvoiceSchedule[]
  items                          SubscriptionItem[]
  providerLinks                  SubscriptionProviderLink[]
  billingInvoices                BillingInvoice[]
  canonicalMigrationLedger       CanonicalMigrationLedger?                   @relation("CanonicalMigrationTarget")
  canonicalManualPilotActivation CanonicalManualPilotActivation?             @relation("CanonicalManualPilotTarget")
  operationalActivation          CanonicalSubscriptionOperationalActivation?

  @@index([customerId, updatedAt(sort: Desc)])
  @@index([status])
}

/// Durable staff approval for a normal, newly-onboarded canonical agreement.
/// This intentionally does not replace the separately authorized legacy/manual
/// pilot mechanism. One agreement can be operationally activated only once.
model CanonicalSubscriptionOperationalActivation {
  id                     String                      @id @default(uuid())
  customerSubscriptionId String                      @unique
  customerSubscription   CustomerSubscription        @relation(fields: [customerSubscriptionId], references: [id], onDelete: Restrict)
  customerId             String
  customer               Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  activationKey          String                      @unique
  initialBillingMode     CanonicalInitialBillingMode
  initialPeriodStart     DateTime?                   @db.Date
  initialPeriodEnd       DateTime?                   @db.Date
  initialInvoiceId       String?                     @unique
  initialInvoice         Invoice?                    @relation("CanonicalOperationalInitialInvoice", fields: [initialInvoiceId], references: [id], onDelete: Restrict)
  approvedById           String
  approvedBy             User                        @relation("CanonicalActivationApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt             DateTime
  performedById          String
  performedBy            User                        @relation("CanonicalActivationPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  performedAt            DateTime
  confirmationNote       String?                     @db.Text
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([customerId, performedAt])
}

/// Stable commercial identity for one billable GPS tracking service.
model SubscriptionItem {
  id                     String                 @id @default(uuid())
  customerSubscriptionId String
  customerSubscription   CustomerSubscription   @relation(fields: [customerSubscriptionId], references: [id], onDelete: Restrict)
  label                  String?
  status                 SubscriptionItemStatus @default(draft)
  serviceActivatedDate   DateTime?              @db.Date
  billingEffectiveFrom   DateTime?              @db.Date
  billingEffectiveUntil  DateTime?              @db.Date
  endedAt                DateTime?
  notes                  String?                @db.Text

  /// A transfer creates a successor item instead of rewriting historical subscription ownership.
  predecessorItemId String?           @unique
  predecessorItem   SubscriptionItem? @relation("SubscriptionItemTransfer", fields: [predecessorItemId], references: [id], onDelete: Restrict)
  successorItem     SubscriptionItem? @relation("SubscriptionItemTransfer")

  serviceAssignments ServiceAssignment[]
  rates              SubscriptionItemRate[]
  invoiceSnapshots   InvoiceServiceSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerSubscriptionId, status])
}

/// Effective-dated agreed price for one subscription item and billing basis.
model SubscriptionItemRate {
  id                    String                         @id @default(uuid())
  subscriptionItemId    String
  subscriptionItem      SubscriptionItem               @relation(fields: [subscriptionItemId], references: [id], onDelete: Cascade)
  billingIntervalMonths Int
  agreedAmountPerCycle  Decimal                        @db.Decimal(12, 2)
  currency              String                         @db.VarChar(3)
  effectiveFrom         DateTime                       @db.Date
  effectiveUntil        DateTime?                      @db.Date
  classification        SubscriptionRateClassification @default(standard)
  changeReason          String?                        @db.Text
  createdById           String?
  createdBy             User?                          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  invoiceSnapshots      InvoiceServiceSnapshot[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([subscriptionItemId, billingIntervalMonths, effectiveFrom])
  @@index([createdById])
}

/// Historical relationship between a canonical subscription and an external provider subscription.
model SubscriptionProviderLink {
  id                     String                     @id @default(uuid())
  customerSubscriptionId String
  customerSubscription   CustomerSubscription       @relation(fields: [customerSubscriptionId], references: [id], onDelete: Restrict)
  provider               BillingProvider
  externalSubscriptionId String
  providerStatus         String?
  activatedAt            DateTime                   @default(now())
  endedAt                DateTime?
  lastSyncedAt           DateTime?
  lastError              String?                    @db.Text
  metadata               Json?
  providerItems          SubscriptionProviderItem[]
  billingInvoices        BillingInvoice[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([provider, externalSubscriptionId])
  @@index([customerSubscriptionId, provider])
}

/// Provider integration state for one external recurring rate group.
model SubscriptionProviderItem {
  id                         String                   @id @default(uuid())
  subscriptionProviderLinkId String
  subscriptionProviderLink   SubscriptionProviderLink @relation(fields: [subscriptionProviderLinkId], references: [id], onDelete: Restrict)
  externalSubscriptionItemId String                   @unique
  externalPriceId            String
  currency                   String                   @db.VarChar(3)
  billingIntervalMonths      Int
  agreedAmountPerCycle       Decimal                  @db.Decimal(12, 2)
  quantity                   Int
  rateGroupFingerprint       String
  lastSyncedAt               DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  @@unique([subscriptionProviderLinkId, rateGroupFingerprint])
  @@index([externalPriceId])
}

/// Durable audit and idempotency record for one approved Phase 2B shadow migration.
model CanonicalMigrationLedger {
  id                    String                          @id @default(uuid())
  migrationKey          String                          @unique
  sourceKind            String
  sourceId              String
  customerId            String
  customer              Customer                        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceFingerprint     String
  planFingerprint       String
  status                CanonicalMigrationStatus        @default(approved)
  approvedPlan          Json
  approvedBy            String
  approvalReason        String                          @db.Text
  approvedAt            DateTime
  targetSubscriptionId  String?                         @unique
  targetSubscription    CustomerSubscription?           @relation("CanonicalMigrationTarget", fields: [targetSubscriptionId], references: [id], onDelete: Restrict)
  startedAt             DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  reversedAt            DateTime?
  failureCode           String?
  failureMessage        String?                         @db.Text
  reconciliation        Json?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  manualPilotActivation CanonicalManualPilotActivation?

  @@unique([sourceKind, sourceId])
  @@index([customerId, status])
  @@index([status, updatedAt])
}

/// Owner-approved campaign for migrating legacy arrangements into protected
/// canonical shadows. It deliberately has no billing-authority field: legacy
/// schedules and provider subscriptions remain authoritative until a separate,
/// explicitly authorized cutover.
model CanonicalMigrationCampaign {
  id                 String                            @id @default(uuid())
  title              String
  status             CanonicalMigrationCampaignStatus  @default(approved)
  sourceAnalysisDate String
  sourceFingerprint  String
  planFingerprint    String
  ownerConfirmations Json
  approvalReason     String                            @db.Text
  createdById        String
  createdBy          User                              @relation("CanonicalMigrationCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById       String
  approvedBy         User                              @relation("CanonicalMigrationCampaignApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt         DateTime
  executionStartedAt DateTime?
  completedAt        DateTime?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  entries            CanonicalMigrationCampaignEntry[]

  @@index([status, updatedAt])
  @@index([approvedById, approvedAt])
}

/// Immutable reviewed plan for one customer/source arrangement. The exact plan
/// and source fingerprints are retained before execution, allowing a failed
/// entry to be retried safely without reopening completed entries.
model CanonicalMigrationCampaignEntry {
  id                   String                                @id @default(uuid())
  campaignId           String
  campaign             CanonicalMigrationCampaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  proposalId           String
  migrationKey         String
  customerId           String
  customer             Customer                              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceKind           String
  sourceId             String
  sourceFingerprint    String
  planFingerprint      String
  approvedPlan         Json
  status               CanonicalMigrationCampaignEntryStatus @default(approved)
  migrationLedgerId    String?
  targetSubscriptionId String?
  failureCode          String?
  failureMessage       String?                               @db.Text
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                              @default(now())
  updatedAt            DateTime                              @updatedAt

  @@unique([campaignId, proposalId])
  @@index([campaignId, status])
  @@index([customerId, status])
  @@index([migrationKey])
}

/// One explicitly authorized transfer from a legacy manual schedule to canonical billing.
/// The activation row is durable even when an execution attempt rolls back.
model CanonicalManualPilotActivation {
  id                     String                     @id @default(uuid())
  activationKey          String                     @unique
  authorizationId        String                     @unique
  migrationLedgerId      String                     @unique
  migrationLedger        CanonicalMigrationLedger   @relation(fields: [migrationLedgerId], references: [id], onDelete: Restrict)
  customerId             String
  customer               Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  targetSubscriptionId   String                     @unique
  targetSubscription     CustomerSubscription       @relation("CanonicalManualPilotTarget", fields: [targetSubscriptionId], references: [id], onDelete: Restrict)
  /// The original authority is either an existing manual schedule or a regular manual invoice.
  sourceKind             String                     @default("manual_schedule") @db.VarChar(32)
  legacyScheduleId       String?                    @unique
  legacySchedule         RecurringInvoiceSchedule?  @relation("CanonicalManualPilotLegacySchedule", fields: [legacyScheduleId], references: [id], onDelete: Restrict)
  sourceInvoiceId        String?                    @unique
  sourceInvoice          Invoice?                   @relation("CanonicalManualPilotSourceInvoice", fields: [sourceInvoiceId], references: [id], onDelete: Restrict)
  canonicalScheduleId    String?                    @unique
  canonicalSchedule      RecurringInvoiceSchedule?  @relation("CanonicalManualPilotCanonicalSchedule", fields: [canonicalScheduleId], references: [id], onDelete: Restrict)
  status                 CanonicalManualPilotStatus @default(approved)
  sourceStateFingerprint String
  proposalFingerprint    String
  approvalFingerprint    String
  cutoverPeriodStart     DateTime                   @db.Date
  recurringAmount        Decimal                    @db.Decimal(12, 2)
  currency               String                     @db.VarChar(3)
  billingIntervalMonths  Int
  approvedBy             String
  approvalReason         String                     @db.Text
  approvedAt             DateTime
  startedAt              DateTime?
  activatedAt            DateTime?
  failedAt               DateTime?
  reversedAt             DateTime?
  failureCode            String?
  failureMessage         String?                    @db.Text
  reconciliation         Json?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([customerId, status])
  @@index([status, updatedAt])
}

/// Maps a TL device to a vendor GPS/telematics identity.
model ProviderDeviceLink {
  id                 String         @id @default(uuid())
  deviceId           String
  device             Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  provider           GpsProvider
  externalDeviceId   String?
  externalAccountRef String?
  portalUrl          String?
  role               DeviceLinkRole @default(primary)
  linkedAt           DateTime       @default(now())
  unlinkedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([deviceId, provider])
  @@index([deviceId])
  @@index([provider])
}

/// Reusable copy for customer broadcast emails (and future WhatsApp).
model BroadcastTemplate {
  id           String                    @id @default(uuid())
  /// Stable key for seeded system templates (`outage-investigating`, etc.).
  slug         String?                   @unique
  name         String
  category     BroadcastTemplateCategory @default(general)
  subject      String
  bodyText     String                    @db.Text
  /// Phase 2: shorter plain body for WhatsApp when channel is enabled.
  whatsappBody String?                   @db.Text
  isSystem     Boolean                   @default(false)
  isActive     Boolean                   @default(true)
  sortOrder    Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  campaigns    BroadcastCampaign[]

  @@index([category])
  @@index([isActive, sortOrder])
}

/// Mass email send to a filtered customer audience (snapshot subject/body at send time).
model BroadcastCampaign {
  id               String                  @id @default(uuid())
  templateId       String?
  template         BroadcastTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subjectSnapshot  String
  bodyTextSnapshot String                  @db.Text
  /// When false, only customers with an active service assignment; when true, all customers with email.
  includeInactive  Boolean                 @default(false)
  incidentTitle    String?
  incidentStatus   String?
  incidentEta      String?
  status           BroadcastCampaignStatus @default(queued)
  totalRecipients  Int                     @default(0)
  sentCount        Int                     @default(0)
  failedCount      Int                     @default(0)
  skippedCount     Int                     @default(0)
  actorUserId      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?

  deliveries BroadcastDelivery[]

  @@index([status, createdAt])
  @@index([createdAt])
}

/// Per-customer email attempt for a broadcast campaign.
model BroadcastDelivery {
  id         String                  @id @default(uuid())
  campaignId String
  campaign   BroadcastCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email      String
  status     BroadcastDeliveryStatus @default(pending)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime                @default(now())

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@index([customerId])
}

/// TL-native audit trail for ops and future automation (not vendor telemetry).
model OperationalEvent {
  id          String    @id @default(uuid())
  occurredAt  DateTime  @default(now())
  category    String
  summary     String
  payload     Json?
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deviceId    String?
  device      Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  actorUserId String?

  @@index([customerId, occurredAt])
  @@index([deviceId, occurredAt])
  @@index([category, occurredAt])
}

// --- Native billing (Phase 0) ---
// TL-owned quote → invoice → payment lifecycle. Additive to the existing
// Invoiless (external) and Stripe `BillingInvoice` (mirror) flows; nothing here
// replaces them yet. UI wiring and cutover happen in later phases.

/// TL-native quote / estimate. Persisted (unlike the legacy stateless quick-quote).
model Quote {
  id     String      @id @default(uuid())
  status QuoteStatus @default(draft)

  /// Customer-facing number, `TL-Q-{n}`, allocated from QuoteSequence when sent.
  number String? @unique

  /// Optional linked customer; free-text bill-to is supported for ad-hoc estimates.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Snapshot of who the quote is addressed to (stable even if the Customer is later edited).
  billToName  String?
  billToLines String[] @default([])

  currency       String   @default("XCD")
  /// Stored money snapshots (computed from line items at save time).
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  /// Single document-level tax (e.g. VAT). Per-line tax is out of scope for Phase 0.
  taxLabel       String?
  taxRatePercent Decimal? @db.Decimal(5, 2)
  taxTotal       Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)

  issueDate  DateTime  @default(now())
  validUntil DateTime?
  notes      String?   @db.Text

  /// Public accept/decline token for a shareable quote link.
  publicToken String?   @unique
  sentAt      DateTime?
  acceptedAt  DateTime?
  declinedAt  DateTime?

  pdfStoragePath String?
  pdfGeneratedAt DateTime?

  /// Invoice generated from this quote (set when status = converted).
  convertedInvoiceId String?  @unique
  convertedInvoice   Invoice? @relation("QuoteConvertedInvoice", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lineItems QuoteLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([updatedAt])
}

model QuoteLineItem {
  id String @id @default(uuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 4)
  unitLabel   String?
  unitPrice   Decimal @db.Decimal(12, 2)
  /// quantity × unitPrice, snapshotted at save time.
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)

  @@index([quoteId])
}

/// TL-native invoice — the going-forward AR record (Invoiless replacement).
/// Separate from `BillingInvoice` (Stripe mirror) for now; may unify in Phase 4.
model Invoice {
  id                               String                         @id @default(uuid())
  status                           InvoiceStatus                  @default(draft)
  kind                             InvoiceKind                    @default(one_off)
  /// A standalone invoice is excluded from canonical migration until the owner
  /// explicitly classifies it as recurring subscription evidence.
  migrationClassification          InvoiceMigrationClassification @default(unreviewed)
  migrationClassificationUpdatedAt DateTime?

  /// Customer-facing number `TL-INV-{n}`, allocated from the shared InvoiceSequence on finalize.
  number String? @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Optional canonical commercial agreement attribution. Null remains valid for legacy/history.
  customerSubscriptionId String?
  customerSubscription   CustomerSubscription? @relation(fields: [customerSubscriptionId], references: [id], onDelete: SetNull)

  billToName  String?
  billToLines String[] @default([])

  currency       String   @default("XCD")
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  /// Flat document-level discount (applied before tax). Snapshotted at save time.
  discountTotal  Decimal  @default(0) @db.Decimal(12, 2)
  taxLabel       String?
  taxRatePercent Decimal? @db.Decimal(5, 2)
  taxTotal       Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)
  /// Sum of recorded payments; `amountDue` = total − amountPaid.
  amountPaid     Decimal  @default(0) @db.Decimal(12, 2)
  amountDue      Decimal  @default(0) @db.Decimal(12, 2)

  issueDate           DateTime  @default(now())
  dueDate             DateTime?
  notes               String?   @db.Text
  /// Cash/bank/cheque payment instructions printed on the PDF (key for non-card payers).
  paymentInstructions String?   @db.Text
  /// When true, the public pay link offers Stripe Checkout for the outstanding balance.
  allowOnlinePayment  Boolean   @default(false)

  publicToken String?   @unique
  sentAt      DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  /// Set when staff hides a churned / uncollectable invoice from active lists and AR.
  archivedAt  DateTime?

  pdfStoragePath String?
  pdfGeneratedAt DateTime?

  /// Quote this invoice was converted from (back-reference; FK lives on Quote.convertedInvoiceId).
  sourceQuote                           Quote?                                      @relation("QuoteConvertedInvoice")
  /// Optional ops link for traceability to a device service assignment.
  serviceAssignmentId                   String?
  /// Recurring schedule that generated this invoice (when kind = recurring).
  recurringScheduleId                   String?
  recurringSchedule                     RecurringInvoiceSchedule?                   @relation("ScheduleGeneratedInvoices", fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  /// Immutable source evidence for a pilot that begins from a one-off/manual invoice.
  manualPilotSourceActivation           CanonicalManualPilotActivation?             @relation("CanonicalManualPilotSourceInvoice")
  migrationClassificationAudits         InvoiceMigrationClassificationAudit[]
  /// UTC billing-period day used by recurring generation idempotency.
  recurringPeriodStart                  DateTime?
  /// Stable schedule + billing-period key. Null on historical/non-recurring invoices.
  recurringGenerationKey                String?                                     @unique
  /// Automatic email/PDF delivery state for recurring generation only.
  recurringDeliveryStatus               RecurringInvoiceDeliveryStatus?
  recurringDeliveryAttempts             Int                                         @default(0)
  recurringDeliveryClaimedAt            DateTime?
  recurringDeliveryError                String?                                     @db.Text
  /// Stable idempotency key for a one-time canonical annual service-addition adjustment.
  adjustmentGenerationKey               String?                                     @unique
  /// Stable idempotency key for an activation-time canonical invoice.
  canonicalInitialGenerationKey         String?                                     @unique
  canonicalOperationalInitialActivation CanonicalSubscriptionOperationalActivation? @relation("CanonicalOperationalInitialInvoice")
  /// Stripe `BillingInvoice` mirror row (when kind = subscription_mirror).
  billingInvoiceId                      String?                                     @unique
  billingInvoice                        BillingInvoice?                             @relation(fields: [billingInvoiceId], references: [id], onDelete: SetNull)

  /// Source Invoiless invoice id when `kind = invoiless_import` (dedup for backfill).
  invoilessInvoiceId  String?   @unique
  /// Original Invoiless invoice number for display on imported rows.
  legacyInvoiceNumber String?
  importedAt          DateTime?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lineItems                     InvoiceLineItem[]
  payments                      Payment[]
  serviceSnapshots              InvoiceServiceSnapshot[]
  scheduledEmails               ScheduledInvoiceEmail[]
  billingNotificationDeliveries BillingNotificationDelivery[]
  lastOnSchedule                RecurringInvoiceSchedule?     @relation("ScheduleLastInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([customerSubscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([updatedAt])
  @@index([recurringScheduleId])
  @@index([archivedAt])
}

/// Append-only audit trail for owner classification of a standalone invoice.
/// This never changes the invoice, its payments, or its financial totals.
model InvoiceMigrationClassificationAudit {
  id             String                         @id @default(uuid())
  invoiceId      String
  invoice        Invoice                        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  classification InvoiceMigrationClassification
  reason         String                         @db.Text
  classifiedById String
  classifiedBy   User                           @relation(fields: [classifiedById], references: [id], onDelete: Restrict)
  createdAt      DateTime                       @default(now())

  @@index([invoiceId, createdAt])
  @@index([classifiedById])
}

/// Staff-scheduled native invoice email (processed by daily cron).
model ScheduledInvoiceEmail {
  id        String                      @id @default(uuid())
  invoiceId String
  invoice   Invoice                     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  status    ScheduledInvoiceEmailStatus @default(pending)
  /// Send on or after this instant (start of chosen Atlantic calendar day).
  sendAt    DateTime
  to        String
  cc        String[]                    @default([])
  bcc       String[]                    @default([])
  subject   String
  bodyText  String                      @db.Text

  scheduledById String?
  scheduledBy   User?   @relation(fields: [scheduledById], references: [id], onDelete: SetNull)

  sentAt    DateTime?
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sendAt])
  @@index([invoiceId])
}

/// Template for auto-generated recurring TL invoices (replaces Invoiless retainers).
model RecurringInvoiceSchedule {
  id     String                  @id @default(uuid())
  status RecurringScheduleStatus @default(active)
  /// Staff label, e.g. "Fleet monitoring — Acme Ltd".
  name   String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Optional canonical agreement attribution; legacy schedules remain valid without it.
  customerSubscriptionId String?
  customerSubscription   CustomerSubscription? @relation(fields: [customerSubscriptionId], references: [id], onDelete: SetNull)

  billToName  String?
  billToLines String[] @default([])

  currency            String   @default("XCD")
  taxLabel            String?
  taxRatePercent      Decimal? @db.Decimal(5, 2)
  notes               String?  @db.Text
  paymentInstructions String?  @db.Text

  /// Billing cadence in months (1, 3, 4, 6, or 12).
  intervalMonths    Int      @default(1)
  /// Next date to issue an invoice (UTC noon semantics in app code).
  nextIssueDate     DateTime
  /// Due date = issue date + this many calendar days.
  dueDaysAfterIssue Int      @default(30)

  autoEmail Boolean @default(true)
  /// Override recipient; defaults to linked customer email when null.
  emailTo   String?

  serviceAssignmentId String?

  lastGeneratedAt DateTime?
  lastInvoiceId   String?   @unique
  lastInvoice     Invoice?  @relation("ScheduleLastInvoice", fields: [lastInvoiceId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  lineItems                      RecurringScheduleLineItem[]
  generatedInvoices              Invoice[]                       @relation("ScheduleGeneratedInvoices")
  legacyManualPilotActivation    CanonicalManualPilotActivation? @relation("CanonicalManualPilotLegacySchedule")
  canonicalManualPilotActivation CanonicalManualPilotActivation? @relation("CanonicalManualPilotCanonicalSchedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([customerSubscriptionId])
  @@index([status, nextIssueDate])
}

model RecurringScheduleLineItem {
  id String @id @default(uuid())

  scheduleId String
  schedule   RecurringInvoiceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 4)
  unitLabel   String?
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)

  @@index([scheduleId])
}

model InvoiceLineItem {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sortOrder        Int                      @default(0)
  description      String
  quantity         Decimal                  @default(1) @db.Decimal(12, 4)
  unitLabel        String?
  unitPrice        Decimal                  @db.Decimal(12, 2)
  lineTotal        Decimal                  @default(0) @db.Decimal(12, 2)
  serviceSnapshots InvoiceServiceSnapshot[]

  @@index([invoiceId])
}

/// Immutable financial attribution for each commercial service represented in a native invoice.
model InvoiceServiceSnapshot {
  id                           String                @id @default(uuid())
  invoiceId                    String
  invoice                      Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceLineItemId            String?
  invoiceLineItem              InvoiceLineItem?      @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)
  subscriptionItemId           String?
  subscriptionItem             SubscriptionItem?     @relation(fields: [subscriptionItemId], references: [id], onDelete: Restrict)
  subscriptionItemRateId       String?
  subscriptionItemRate         SubscriptionItemRate? @relation(fields: [subscriptionItemRateId], references: [id], onDelete: Restrict)
  serviceLabelSnapshot         String?
  agreedAmountPerCycleSnapshot Decimal?              @db.Decimal(12, 2)
  billedAmount                 Decimal               @db.Decimal(12, 2)
  currency                     String                @db.VarChar(3)
  servicePeriodStart           DateTime?             @db.Date
  servicePeriodEnd             DateTime?             @db.Date
  providerInvoiceLineReference String?
  quantity                     Decimal               @default(1) @db.Decimal(12, 4)
  allocationNotes              String?               @db.Text
  createdAt                    DateTime              @default(now())

  @@unique([invoiceId, subscriptionItemId])
  @@index([invoiceId])
  @@index([invoiceLineItemId])
  @@index([subscriptionItemId])
  @@index([subscriptionItemRateId])
  @@index([providerInvoiceLineReference])
}

/// A payment received against a native invoice (supports partial + manual methods).
model Payment {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Denormalized for AR/customer reporting; nullable for ad-hoc invoices.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  amount                Decimal       @db.Decimal(12, 2)
  currency              String        @default("XCD")
  method                PaymentMethod @default(cash)
  /// External or manual reference (cheque #, bank ref, Stripe PaymentIntent id).
  reference             String?
  stripePaymentIntentId String?       @unique
  receivedAt            DateTime      @default(now())
  notes                 String?

  recordedById String?
  recordedBy   User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  voidedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([invoiceId])
  @@index([customerId, receivedAt(sort: Desc)])
}

// --- Native billing (Phase 5): expense register ---

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bills VendorBill[]

  @@index([sortOrder])
}

/// Simple ops expense — vendor, amount, date, optional receipt and cost attribution.
model Vendor {
  id           String   @id @default(uuid())
  name         String
  email        String?
  phone        String?
  currency     String   @default("XCD")
  paymentTerms Int      @default(30)
  notes        String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bills VendorBill[]

  @@index([name])
  @@index([isActive, name])
}

model VendorBill {
  id                  String              @id @default(uuid())
  status              VendorBillStatus    @default(draft)
  vendorId            String
  vendor              Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorInvoiceNumber String?
  description         String?
  currency            String              @default("XCD")
  total               Decimal             @db.Decimal(12, 2)
  amountPaid          Decimal             @default(0) @db.Decimal(12, 2)
  amountDue           Decimal             @db.Decimal(12, 2)
  billDate            DateTime
  dueDate             DateTime?
  notes               String?             @db.Text
  categoryId          String?
  category            ExpenseCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customerId          String?
  customer            Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deviceId            String?
  device              Device?             @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// Vercel Blob url, `private:` prefix, or local `/uploads/expenses/…` path.
  receiptStoragePath  String?
  createdById         String?
  createdBy           User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payments            VendorBillPayment[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([vendorId])
  @@index([categoryId])
  @@index([customerId])
  @@index([deviceId])
  @@index([status])
  @@index([dueDate])
  @@index([updatedAt])
}

model VendorBillPayment {
  id           String               @id @default(uuid())
  billId       String
  bill         VendorBill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount       Decimal              @db.Decimal(12, 2)
  currency     String               @default("XCD")
  method       ExpensePaymentMethod @default(bank_transfer)
  reference    String?
  paidAt       DateTime             @default(now())
  notes        String?
  recordedById String?
  recordedBy   User?                @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  voidedAt     DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([billId, paidAt])
  @@index([recordedById])
}
